# CylinderUI router — environment (EXAMPLE). Copy to ".env" and edit.
# NEVER commit real secrets, tokens, API keys or LAN hostnames — use placeholders.

# --- Ports / bind ------------------------------------------------------------
PROMPT_ROUTER_HOST=0.0.0.0
PROMPT_ROUTER_PORT=8088
LLAMA_SWAP_URL=http://127.0.0.1:8080

# --- Optional Bearer-token auth for the LAN console --------------------------
# Leave both blank to keep the console open on the LAN (default). Set ONE to
# enable a constant-time Bearer gate over /api/*, /router/* and /v1/*.
#   CYLINDERUI_AUTH_TOKEN       -- the token value itself.
#   CYLINDERUI_AUTH_TOKEN_FILE  -- path to a file containing the token.
CYLINDERUI_AUTH_TOKEN=
CYLINDERUI_AUTH_TOKEN_FILE=

# --- Optional cloud provider credentials (referenced by router-config) -------
# CLOUD_PROVIDER_API_KEY=
