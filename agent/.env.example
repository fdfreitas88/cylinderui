# CylinderUI agent — example environment (copy to .env)

# --- Auth (upstream router bearer token; leave blank for local dev) ---
CYLINDERUI_AUTH_TOKEN=

# --- Ports ---
AGENT_PORT=3000

# --- Upstream services ---
# OpenAI-compatible router (chat/completions, models)
ROUTER_URL=http://127.0.0.1:8088/v1
# llama-swap backend
LLAMA_SWAP_URL=http://127.0.0.1:8080
# Agent upstream base (if fronted by a proxy/router)
AGENT_UPSTREAM=http://127.0.0.1:8088

# --- Models / storage ---
MODELS_DIR=./models
# Optional: default model id served by the router
AGENT_MODEL=

# --- Local data dirs (default under repo; override to relocate) ---
KNOWLEDGE_DIR=./data/knowledge
LOG_DIR=./data/logs
