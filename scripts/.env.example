# =============================================================================
# CylinderUI for Llama.cpp - environment (EXAMPLE)
# -----------------------------------------------------------------------------
# Copy to ".env" and adjust. NEVER put real secrets, tokens, API keys or LAN
# hostnames in the committed .example file -- use placeholders only. The real
# .env is git-ignored and lives on your machine.
# =============================================================================

# --- Ports (must match INSTALL.md) -------------------------------------------
PROMPT_ROUTER_PORT=8088        # Router (UI + /api proxy) - the URL you open
AGENT_PORT=3000               # native-agent-v2 (FastAPI) - loopback only
LLAMA_SWAP_PORT=8080          # llama-swap (model swapper + inference front)

# --- Bind host ---------------------------------------------------------------
# Router listens on 0.0.0.0 by default so you can reach it from the LAN.
# Set to 127.0.0.1 to keep it local-only.
PROMPT_ROUTER_HOST=0.0.0.0

# --- Internal wiring (consumed by router + agent) ----------------------------
LLAMA_SWAP_URL=http://127.0.0.1:8080
ROUTER_URL=http://127.0.0.1:8088/v1

# --- Default model id (as advertised by llama-swap) --------------------------
AGENT_MODEL=qwen2.5-0.5b-instruct

# --- Initial GGUF model download ---------------------------------------------
# Small, permissively-licensed instruct model in Q4. Change freely.
# The installer PRINTS this command and asks for confirmation before any
# network download (nothing is fetched without your approval).
MODEL_URL=https://huggingface.co/Qwen/Qwen2.5-0.5B-Instruct-GGUF/resolve/main/qwen2.5-0.5b-instruct-q4_k_m.gguf
MODEL_FILE=qwen2.5-0.5b-instruct-q4_k_m.gguf

# --- Optional: cloud provider credentials ------------------------------------
# Referenced by router-config.json via "api_key_env". Leave BLANK here; set the
# real value only in your local .env (never commit it).
# CLOUD_PROVIDER_API_KEY=
